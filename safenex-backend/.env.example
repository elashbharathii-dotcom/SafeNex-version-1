# SAFENEX AI CORE - Secure Backend Environment Variables Template
# Copy to .env and configure for your environment.
# NEVER commit production keys or .env to version control.

PORT=5001
HOST=0.0.0.0
NODE_ENV=development

# Google Gemini AI API Key (Stored EXCLUSIVELY on backend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Supabase JWT Secret for cryptographic token signature verification
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_URL=https://your-project-id.supabase.co

# Allowed CORS origins (comma-separated, no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional backend-to-backend master secret for administrative/worker hooks only
# (Never share or expose to frontend or mobile clients)
SAFENEX_BACKEND_SECRET=generate_a_random_64_char_hex_secret_here
